# Bu dosyayı .env adıyla kopyala ve gerçek değerleri yaz. .env repoya girmez.

DATABASE_URL=postgresql+psycopg://trendanalys:sifre@localhost:5432/trendanalys

# Kod inceleme ajanı (agents/reviewer.py)
# ollama: yerel, ücretsiz, anahtar istemez | gemini | claude
REVIEWER_PROVIDER=ollama
# Boş bırakılırsa sağlayıcının varsayılanı kullanılır:
# qwen3:4b / gemini-flash-latest / claude-sonnet-5
REVIEWER_MODEL=
# Asıl sağlayıcı kota/yoğunluk nedeniyle cevap vermezse buna düşülür
REVIEWER_FALLBACK=ollama

# Gerçek anahtarlar SADECE .env dosyasına yazılır, buraya değil
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
